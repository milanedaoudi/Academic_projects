# -*- coding: utf-8 -*-
from posit import posit
import math

def calculate_errors():
    # Initialize 8-bit posit with es=1
    p = posit(8, 1)
    
    # Read files
    with open("posit_results.txt", "r") as f_posit, \
         open("results_float.txt", "r") as f_float:
        
        posit_lines = [line.strip() for line in f_posit if line.strip()]
        float_lines = [line.strip() for line in f_float if line.strip()]
    
    # Verify file lengths match
    if len(posit_lines) != len(float_lines):
        print("Error: Files have different lengths!")
        print("posit_results.txt has {} lines".format(len(posit_lines)))
        print("results_float.txt has {} lines".format(len(float_lines)))
        return
    
    # Process results and calculate errors
    total_error = 0.0
    valid_count = 0
    
    with open("error.txt", "w") as f_error:
        for i in xrange(len(posit_lines)):
            try:
                # Convert posit string to float
                posit_bits = posit_lines[i]
                posit_float = p.posit2float(posit_bits)
                
                # Get reference float result
                reference_float = float(float_lines[i])
                
                # Calculate absolute error
                if math.isnan(reference_float) or math.isnan(posit_float):
                    error = float('nan')
                else:
                    error = abs(posit_float - reference_float)
                    total_error += error
                    valid_count += 1
                
                # Write error to file
                f_error.write("{:.15g}\n".format(error))
                
            except (ValueError, IndexError) as e:
                f_error.write("NaN\n")
                print("Error processing line {}: {}".format(i+1, str(e)))
    
    # Calculate and display average error
    if valid_count > 0:
        avg_error = total_error / valid_count
        print("Average error: {:.15g}".format(avg_error))
    else:
        print("No valid error calculations could be performed")

if __name__ == "__main__":
    calculate_errors()
    print("Error calculations complete. Results saved to error.txt")
