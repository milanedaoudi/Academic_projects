# -*- coding: utf-8 -*-
from posit import posit
import random
import struct

def generate_test_data():
    # Initialize 8-bit posit with es=1
    p = posit(16, 8)
    
    # Generate random doubles in [0.01, 0.1]
    num_values = 65534  #CHANGE this to change toal number of test
    print("Generating random doubles...")
    list1 = [random.uniform(0.001, 0.01) for _ in xrange(num_values)]
    list2 = [random.uniform(0.001, 0.01) for _ in xrange(num_values)]
    
    # Create results_float.txt with additions
    print("Creating float results...")
    with open("results_float.txt", "w") as f_float:
        for a, b in zip(list1, list2):
            res = a * b
            f_float.write("{:.15g}\n".format(res))
    
    # Convert to posit and create input files
    print("Converting to posit...")
    with open("Pin1_16bit.txt", "w") as f_pin1, \
         open("Pin2_16bit.txt", "w") as f_pin2:
        
        for a, b in zip(list1, list2):
            try:
                posit1 = p.float2posit(a)
                posit2 = p.float2posit(b)
                f_pin1.write(posit1 + "\n")
                f_pin2.write(posit2 + "\n")
            except Exception as e:
                print("Conversion error: {}".format(str(e)))
                f_pin1.write("00000000\n")  # Write zero on error
                f_pin2.write("00000000\n")
    
    print("Operation complete:")
    print("- Generated {} random pairs in [0.01, 0.1]".format(num_values))
    print("- Created results_float.txt with additions")
    print("- Created Pin1_16bit.txt and Pin2_16bit.txt with posit conversions")

if __name__ == "__main__":
    generate_test_data()
