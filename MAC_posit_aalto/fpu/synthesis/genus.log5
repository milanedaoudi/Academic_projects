@file(mmmc_config.tcl) 42: foreach setupc $setup_corners {
  puts "Creating operating condition for corner $setupc"
  set tempmax 25
  set tempmin -40
  regexp -all {^(.*)_vdd([0-9]+)v([0-9]+)}  $setupc tot vtot vreal vdec
  puts "$vreal.$vdec"
  puts "$tempmax"
  puts "$tempmin"
  create_opcond \
    -name               $setupc.max \
    -process            1 \
    -voltage            $vreal.$vdec \
    -temperature        "$tempmax"
}
