  regexp -all {^(.*)_vdd([0-9]+)v([0-9]+)}  $setupc tot vtot vreal vdec
  puts "$vreal.$vdec"
  puts "$temp"
  create_opcond \
    -name               $holdc.min \
    -process            1 \
    -voltage            $vreal.$vdec \
    -temperature        "$tempmin"
}
