@file(mmmc_config.tcl) 10: foreach setupc $setup_corners {
  puts "Defining timing files for library set ${setupc}.SS"
  create_library_set \
    -name ${setupc}.SS \
    -timing [subst {
      [glob -nocomplain ./flow/tech/lib/${setup_corners}_basicCells_hvt.lib]
    }]
}
